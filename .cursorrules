## 3️⃣ Performance Monitoring

### 3.1 Page Load Time Tracking

**Status**: ✅ **Already Implemented** in `/assets/js/analytics.js`

**Implementation**:
- Page load time is automatically tracked via `getPerformanceMetrics()`
- Metrics include: `page_load_time`, `dom_processing_time`, `time_to_first_byte`, etc.
- Tracked on every page view via `trackPageView()`

**Rules**:
- ✅ **Page load time tracking is automatic** - No additional code needed
- ✅ **All pages automatically track** performance metrics
- ✅ **Metrics sent to Google Analytics** with page view events

**Available Metrics** (automatically tracked):
- `page_load_time` - Total page load time
- `dom_processing_time` - DOM processing duration
- `time_to_first_byte` - Server response time
- `dns_lookup_time` - DNS lookup duration
- `server_connection_time` - Connection establishment time
- `download_time` - Resource download time
- `connection_type` - Network connection type (4g, 3g, etc.)

### 3.2 UI Freeze Detection

**Rules**:
- ✅ **Implement UI freeze detection** for all heavy operations
- ✅ **Track freeze duration** in analytics
- ✅ **Log freeze events** to Sentry
- ✅ **Threshold**: Log if UI is frozen for > 100ms

**Implementation Pattern**:
```javascript
// UI Freeze Detection Utility
function detectUIFreeze(operationName, operationFunction) {
  return new Promise((resolve, reject) => {
    const startTime = performance.now();
    let lastCheckTime = startTime;
    let maxFreezeDuration = 0;
    
    // Use requestIdleCallback or setTimeout to detect freezes
    function checkFreeze() {
      const currentTime = performance.now();
      const timeSinceLastCheck = currentTime - lastCheckTime;
      
      // If more than 100ms passed, UI was likely frozen
      if (timeSinceLastCheck > 100) {
        const freezeDuration = timeSinceLastCheck;
        maxFreezeDuration = Math.max(maxFreezeDuration, freezeDuration);
        
        // Track freeze event
        trackUIFreeze({
          operation: operationName,
          freeze_duration_ms: freezeDuration,
          page: getCurrentPageNameForAnalytics(),
          timestamp: currentTime
        });
        
        // Log to Sentry
        if (typeof Sentry !== 'undefined') {
          Sentry.addBreadcrumb({
            message: 'UI freeze detected',
            category: 'performance',
            level: 'warning',
            data: {
              operation: operationName,
              freezeDuration: freezeDuration,
              page: getCurrentPageNameForAnalytics()
            }
          });
        }
      }
      
      lastCheckTime = currentTime;
    }
    
    // Check for freezes periodically
    const checkInterval = setInterval(checkFreeze, 50);
    
    // Run the operation
    try {
      const result = operationFunction();
      
      // If it's a promise, wait for it
      if (result instanceof Promise) {
        result.then((data) => {
          clearInterval(checkInterval);
          const totalTime = performance.now() - startTime;
          
          // Track completion with freeze info
          if (maxFreezeDuration > 0) {
            trackOperationComplete({
              operation: operationName,
              total_time_ms: totalTime,
              max_freeze_duration_ms: maxFreezeDuration,
              page: getCurrentPageNameForAnalytics()
            });
          }
          
          resolve(data);
        }).catch((error) => {
          clearInterval(checkInterval);
          reject(error);
        });
      } else {
        clearInterval(checkInterval);
        const totalTime = performance.now() - startTime;
        
        if (maxFreezeDuration > 0) {
          trackOperationComplete({
            operation: operationName,
            total_time_ms: totalTime,
            max_freeze_duration_ms: maxFreezeDuration,
            page: getCurrentPageNameForAnalytics()
          });
        }
        
        resolve(result);
      }
    } catch (error) {
      clearInterval(checkInterval);
      reject(error);
    }
  });
}

// Usage in handlers
function formatHandler() {
  const src = inputEditor.getValue();
  
  // Wrap heavy operation with freeze detection
  detectUIFreeze('format_json', () => {
    return formatJSON(src);
  }).then((result) => {
    outputEditor.setValue(result);
  }).catch((error) => {
    handleFormatError(error);
  });
}

// Analytics helper
function trackUIFreeze(context) {
  if (typeof window.Analytics !== 'undefined') {
    window.Analytics.track('ui_freeze', {
      ...context,
      severity: context.freeze_duration_ms > 500 ? 'high' : 'medium'
    });
  }
}
```

**Alternative: Using Long Task API** (if available):
```javascript
// Long Task API for detecting UI freezes
if ('PerformanceObserver' in window) {
  try {
    const observer = new PerformanceObserver((list) => {
      for (const entry of list.getEntries()) {
        // Long tasks are > 50ms
        if (entry.duration > 50) {
          trackUIFreeze({
            operation: 'long_task',
            freeze_duration_ms: entry.duration,
            page: getCurrentPageNameForAnalytics(),
            task_name: entry.name || 'unknown'
          });
        }
      }
    });
    
    observer.observe({ entryTypes: ['longtask'] });
  } catch (e) {
    // Long Task API not supported
  }
}
```

